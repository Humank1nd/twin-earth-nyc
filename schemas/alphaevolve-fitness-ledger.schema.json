{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin-earth-nyc.game/schemas/alphaevolve-fitness-ledger.schema.json",
  "title": "AlphaEvolve Fitness Ledger Entry",
  "description": "Immutable record of a single AlphaEvolve candidate evaluation. Captures parameters, metrics, constraint results, and the resulting verdict for auditability.",
  "type": "object",
  "required": [
    "run_id",
    "candidate_id",
    "generation",
    "timestamp",
    "evolvable_component",
    "parameters",
    "metrics",
    "constraints",
    "verdict"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Identifier for the AlphaEvolve run or experiment."
    },
    "candidate_id": {
      "type": "string",
      "description": "Identifier for the evaluated candidate genome."
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "description": "Evolution generation number."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the evaluation."
    },
    "evolvable_component": {
      "type": "string",
      "description": "High-level component being optimized (e.g., crowd, LOD, anomaly)."
    },
    "parameters": {
      "type": "object",
      "description": "Parameter values for this candidate. Keys are evolvable parameter names.",
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "description": "Evaluation metrics produced by the scenario runner.",
      "required": ["fitness"],
      "properties": {
        "fitness": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Composite fitness score used for selection."
        },
        "stability": { "type": "number" },
        "performance": { "type": "number" },
        "realism": { "type": "number" },
        "cost": { "type": "number" }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["passed", "violations"],
      "properties": {
        "passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "enum": ["KEEP", "REJECT", "PROMOTE"],
      "description": "Selection outcome for the candidate."
    },
    "seed": {
      "type": "integer",
      "description": "Random seed used for this evaluation, if any."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes for operators."
    }
  },
  "additionalProperties": false
}
